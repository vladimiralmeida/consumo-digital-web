# Copie para .env e preencha. O arquivo .env nunca vai para o repositório.

# Porta HTTP do servidor.
PORT=3000

# Arquivo do banco SQLite. Em contêiner, aponte para um volume persistente (ex.: /data/consumo.db).
DATABASE_PATH=./data/consumo.db

# Administrador inicial. Usado só quando ainda não existe nenhum administrador no banco.
# A senha precisa ter pelo menos 10 caracteres e deve ser trocada no primeiro acesso.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# Em produção (HTTPS) mantenha true. Para testar em http://localhost use false.
COOKIE_SECURE=true

# Número de proxies reversos à frente do servidor (Traefik do Dokploy = 1). Local = 0.
TRUST_PROXY=0

# Diagnóstico com IA (DeepSeek). Sem a chave, a IA fica desativada e o restante funciona.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
