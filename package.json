{
  "name": "consumo-digital-web",
  "version": "0.3.0",
  "private": true,
  "description": "Consumo Digital: triagem, diagnóstico da opacidade e parecer, com persistência por grupo.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
